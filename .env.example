# ═══════════════════════════════════════════════════════════════════════════
# OTP WORKER — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════
# 
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
#
# To set secrets in Cloudflare Workers:
#   wrangler secret put CLIENT_ID
#   wrangler secret put CLIENT_SECRET
#   wrangler secret put REFRESH_TOKEN

# ─── Gmail OAuth2 Credentials ───────────────────────────────────────────────
# Get these from: https://console.cloud.google.com/apis/credentials
CLIENT_ID="YOUR_CLIENT_ID.apps.googleusercontent.com"
CLIENT_SECRET="YOUR_CLIENT_SECRET"
REFRESH_TOKEN="YOUR_REFRESH_TOKEN"

# ─── Sender Configuration ───────────────────────────────────────────────────
# Comma-separated list of allowed sender emails
SENDER_EMAIL_1="you@gmail.com"
SENDER_EMAIL_2="you@yourdomain1.com"
SENDER_EMAIL_3="you@yourdomain2.com"

# ─── OTP Configuration ──────────────────────────────────────────────────────
# OTP validity in milliseconds (default: 10 minutes)
OTP_TTL_MS=600000

# Rate limit window in seconds (default: 5 minutes)
RL_TTL_SEC=300

# Application name (shown in emails)
APP_NAME="MyApp"

# ─── Cloudflare Configuration ──────────────────────────────────────────────
# Your KV Namespace ID (get from: wrangler kv namespace list)
KV_NAMESPACE_ID="your_namespace_id_here"

# Your Cloudflare Zone ID (for production routing)
CLOUDFLARE_ZONE_ID="your_zone_id_here"

# ─── CORS Settings ─────────────────────────────────────────────────────────
# Set to your frontend domain for production (e.g., "https://app.yourdomain.com")
CORS_ORIGIN="*"

# ─── Deployment ────────────────────────────────────────────────────────────
# Environment: development, staging, production
ENVIRONMENT="development"

# Worker URL (for testing)
WORKER_URL="http://localhost:8787"
